# Copy to .env and fill in. NEVER commit .env. This file has placeholders only.

# Backend (FastAPI) & GitHub
# No-scope / public-data token is enough for reading public repos. Never commit the real value.
GITHUB_TOKEN=
# Database: SQLite for local offline development, or Supabase PostgreSQL for cloud
DATABASE_URL=sqlite:///./myopensource.db
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# LLM Provider (gemini | ollama)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=

# Telegram Alerts & Scheduler
TELEGRAM_BOT_TOKEN=
# Turn these on ONLY on the deployed server (and Part C when testing).
# Two processes polling one Telegram bot token causes 409 errors.
ENABLE_SCHEDULER=0
ENABLE_TELEGRAM_BOT=0
POLL_INTERVAL_MINUTES=10

# Demo Script Configuration (scripts/demo_create_issue.py)
DEMO_REPO=
DEMO_GITHUB_TOKEN=

# Frontend Configuration
FRONTEND_ORIGIN=http://localhost:5173
# API Base URL for backend FastAPI service
VITE_API_BASE=http://localhost:8000
# Set to 1 to use offline mock data (mock-first), or 0 to hit real FastAPI backend
VITE_USE_MOCK=1
