# Copy to .env and fill in. NEVER commit .env. This file has placeholders only.

# No-scope / public-data token is enough. Never commit the real value.
GITHUB_TOKEN=
DATABASE_URL=sqlite:///./myopensource.db

LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=

TELEGRAM_BOT_TOKEN=
# Turn these on ONLY on the deployed server (and Part C when testing).
# Two processes polling one Telegram bot token causes 409 errors.
ENABLE_SCHEDULER=0
ENABLE_TELEGRAM_BOT=0
POLL_INTERVAL_MINUTES=10

# Our own demo repo, used only by scripts/demo_create_issue.py
DEMO_REPO=
DEMO_GITHUB_TOKEN=

FRONTEND_ORIGIN=http://localhost:5173
