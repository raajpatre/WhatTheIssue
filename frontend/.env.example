# Backend API Base URL
# For local development with FastAPI running: http://localhost:8000
# For production live deployment: https://<your-backend-domain> (e.g., https://whattheissue-api.onrender.com)
VITE_API_BASE=http://localhost:8000

# Set to 0 to connect to the live FastAPI backend (recommended for live & staging)
# Set to 1 only for offline development with mock fixtures
VITE_USE_MOCK=0
